rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // TALENTFLOW ENTERPRISE FIRESTORE SECURITY RULES
    // Project: pro8-job-portal
    // Strong security: Only authenticated Google Sign-In recruiters
    // can read, schedule, create, or update candidate records.
    // ===============================================================

    // Helper function: check if user is authenticated via Google Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function: check if email is verified
    function hasVerifiedEmail() {
      return isAuthenticated() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // Valid pipeline statuses
    function isValidStatus(status) {
      return status in [
        'New Applied',
        'Screening Shortlisted',
        'Line-Up Scheduled',
        'Interview Done',
        'Selected',
        'Rejected'
      ];
    }

    // Candidates Collection: Strictly guarded
    match /candidates/{candidateId} {
      // Allow read only to authenticated recruiters
      allow read: if isAuthenticated();

      // Allow create if recruiter is authenticated and payload is validated
      allow create: if isAuthenticated()
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.email is string
        && request.resource.data.appliedRole is string
        && isValidStatus(request.resource.data.status);

      // Allow update if recruiter is authenticated and payload is valid
      allow update: if isAuthenticated()
        && (request.resource.data.status == null || isValidStatus(request.resource.data.status));

      // Allow delete only to authenticated recruiters
      allow delete: if isAuthenticated();
    }

    // Recruiter Profiles & Sessions
    match /recruiters/{recruiterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == recruiterId;
    }

    // Audit logs & Activity logs
    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Activity Logs with glowing audit points
    match /activity_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // App Settings (Security PIN, preferences)
    match /settings/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
